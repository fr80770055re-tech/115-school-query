{
  "studentViews": {
    ".read": "auth != null && auth.token.email === 'YOUR_ADMIN_EMAIL'",
    "$date": {
      "$student": {
        "$device": {
          ".write": "!data.exists()",
          ".validate": "newData.val() === now && $date.matches(/^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && $device.matches(/^[a-z0-9]{16,40}$/) && $student.length <= 20"
        }
      }
    }
  }
}

  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "區塊內唯一的主要操作，例如「查詢課表」「上傳圖片」。",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">查詢課表</button>",
      "css": ":host{--accent:#35507a;--accent-strong:#25395a;--accent-soft:#e7ecf3;--accent-contrast:#fff;--club:#4f7a5b;--club-soft:#e8f0ea;--warn:#8a5a0c;--warn-soft:#faf0d9;--surface:#fff;--surface-2:#f0f1ee;--border:#dee0d9;--border-strong:#c9ccc2;--text:#23241f;--text-soft:#5f625a;--text-faint:#767a70;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 24px;border:none;border-radius:9px;background:var(--accent,#35507a);color:var(--accent-contrast,#fff);font:600 15px 'Noto Sans TC',system-ui,sans-serif;cursor:pointer;transition:background .15s,transform .1s;}.ds-btn-primary:hover{background:var(--accent-strong,#25395a);}.ds-btn-primary:active{transform:translateY(1px);}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#35507a);outline-offset:2px;}.ds-btn-primary:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "學生姓名查詢欄，附可見標籤。",
      "html": "<label class=\"ds-label\" for=\"ds-q\">學生姓名</label><input id=\"ds-q\" class=\"ds-input\" type=\"search\" placeholder=\"例如：柯沐恩\">",
      "css": ":host{--accent:#35507a;--accent-strong:#25395a;--accent-soft:#e7ecf3;--accent-contrast:#fff;--club:#4f7a5b;--club-soft:#e8f0ea;--warn:#8a5a0c;--warn-soft:#faf0d9;--surface:#fff;--surface-2:#f0f1ee;--border:#dee0d9;--border-strong:#c9ccc2;--text:#23241f;--text-soft:#5f625a;--text-faint:#767a70;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-label{display:block;margin:0 0 8px;font:600 14px 'Noto Sans TC',system-ui,sans-serif;color:var(--text-soft,#5f625a);}.ds-input{width:100%;min-height:48px;padding:0 16px;border:1px solid var(--border,#dee0d9);border-radius:9px;background:var(--surface-2,#f0f1ee);color:var(--text,#23241f);font:16px 'Noto Sans TC',system-ui,sans-serif;caret-color:var(--accent,#35507a);transition:border-color .15s,background .15s;}.ds-input::placeholder{color:var(--text-faint,#767a70);}.ds-input:hover{border-color:var(--border-strong,#c9ccc2);}.ds-input:focus{outline:2px solid var(--accent,#35507a);outline-offset:1px;background:var(--surface,#fff);}"
    },
    {
      "name": "Jump Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "黏在頂端的頁內導覽膠囊連結。",
      "html": "<nav class=\"ds-nav\"><a href=\"#\">查詢課表</a><a href=\"#\">本週上課情形</a><a href=\"#\">行事曆</a></nav>",
      "css": ":host{--accent:#35507a;--accent-strong:#25395a;--accent-soft:#e7ecf3;--accent-contrast:#fff;--club:#4f7a5b;--club-soft:#e8f0ea;--warn:#8a5a0c;--warn-soft:#faf0d9;--surface:#fff;--surface-2:#f0f1ee;--border:#dee0d9;--border-strong:#c9ccc2;--text:#23241f;--text-soft:#5f625a;--text-faint:#767a70;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-nav{display:flex;justify-content:center;gap:6px;}.ds-nav a{display:inline-flex;align-items:center;min-height:36px;padding:0 14px;border-radius:999px;font:600 14px 'Noto Sans TC',system-ui,sans-serif;color:var(--text-soft,#5f625a);text-decoration:none;transition:background .15s,color .15s;}.ds-nav a:hover{background:var(--surface-2,#f0f1ee);color:var(--text,#23241f);}.ds-nav a:focus-visible{outline:2px solid var(--accent,#35507a);outline-offset:2px;}"
    },
    {
      "name": "Club Chip",
      "kind": "chip",
      "refersTo": "chip-club",
      "description": "顯示學生參加的社團，不可點。",
      "html": "<span class=\"ds-chip-club\">合唱團</span> <span class=\"ds-chip-club\">樂活運動社</span>",
      "css": ":host{--accent:#35507a;--accent-strong:#25395a;--accent-soft:#e7ecf3;--accent-contrast:#fff;--club:#4f7a5b;--club-soft:#e8f0ea;--warn:#8a5a0c;--warn-soft:#faf0d9;--surface:#fff;--surface-2:#f0f1ee;--border:#dee0d9;--border-strong:#c9ccc2;--text:#23241f;--text-soft:#5f625a;--text-faint:#767a70;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-chip-club{display:inline-block;background:var(--club-soft,#e8f0ea);color:var(--club,#4f7a5b);border-radius:999px;padding:5px 14px;font:600 14px 'Noto Sans TC',system-ui,sans-serif;}"
    },
    {
      "name": "Name Choice Chip",
      "kind": "chip",
      "refersTo": "chip-choice",
      "description": "部分姓名符合多位學生時的選項按鈕。",
      "html": "<button class=\"ds-chip-choice\" type=\"button\">吳宇寧</button>",
      "css": ":host{--accent:#35507a;--accent-strong:#25395a;--accent-soft:#e7ecf3;--accent-contrast:#fff;--club:#4f7a5b;--club-soft:#e8f0ea;--warn:#8a5a0c;--warn-soft:#faf0d9;--surface:#fff;--surface-2:#f0f1ee;--border:#dee0d9;--border-strong:#c9ccc2;--text:#23241f;--text-soft:#5f625a;--text-faint:#767a70;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-chip-choice{min-height:40px;padding:0 16px;border:1px solid var(--border,#dee0d9);border-radius:999px;background:var(--surface-2,#f0f1ee);color:var(--text,#23241f);font:500 15px 'Noto Sans TC',system-ui,sans-serif;cursor:pointer;transition:border-color .15s,background .15s;}.ds-chip-choice:hover{border-color:var(--accent,#35507a);background:var(--accent-soft,#e7ecf3);color:var(--accent-strong,#25395a);}.ds-chip-choice:focus-visible{outline:2px solid var(--accent,#35507a);outline-offset:2px;}"
    },
    {
      "name": "Notice Card",
      "kind": "card",
      "refersTo": "notice-card",
      "description": "釘在板面上的白色公告，每個區塊一張。",
      "html": "<section class=\"ds-card\"><h2>本週各類課後班上課情形一覽</h2><p>老師上傳後，這裡會自動顯示最新的上課情形。</p></section>",
      "css": ":host{--accent:#35507a;--accent-strong:#25395a;--accent-soft:#e7ecf3;--accent-contrast:#fff;--club:#4f7a5b;--club-soft:#e8f0ea;--warn:#8a5a0c;--warn-soft:#faf0d9;--surface:#fff;--surface-2:#f0f1ee;--border:#dee0d9;--border-strong:#c9ccc2;--text:#23241f;--text-soft:#5f625a;--text-faint:#767a70;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-card{background:var(--surface,#fff);border:1px solid var(--border,#dee0d9);border-radius:14px;box-shadow:0 1px 2px rgba(35,36,31,.04),0 8px 24px -12px rgba(35,36,31,.12);padding:28px;font:15px/1.6 'Noto Sans TC',system-ui,sans-serif;color:var(--text,#23241f);}.ds-card h2{margin:0 0 12px;font:700 20px/1.4 'Noto Serif TC',serif;}.ds-card p{margin:0;color:var(--text-soft,#5f625a);}"
    },
    {
      "name": "Day Card",
      "kind": "card",
      "refersTo": "day-card",
      "description": "查詢結果中每天的班級、教師、教室；今天的卡片以墨藍淡底標示。",
      "html": "<article class=\"ds-day is-today\"><h3>星期二 <span class=\"ds-tag\">今天</span></h3><dl><div><dt>班級</dt><dd>學力班</dd></div><div><dt>教師</dt><dd>謝朝欽</dd></div><div><dt>教室</dt><dd>六忠</dd></div></dl></article>",
      "css": ":host{--accent:#35507a;--accent-strong:#25395a;--accent-soft:#e7ecf3;--accent-contrast:#fff;--club:#4f7a5b;--club-soft:#e8f0ea;--warn:#8a5a0c;--warn-soft:#faf0d9;--surface:#fff;--surface-2:#f0f1ee;--border:#dee0d9;--border-strong:#c9ccc2;--text:#23241f;--text-soft:#5f625a;--text-faint:#767a70;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-day{background:var(--surface-2,#f0f1ee);border:1px solid var(--border,#dee0d9);border-radius:10px;padding:16px;max-width:220px;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-day.is-today{background:var(--accent-soft,#e7ecf3);}.ds-day h3{display:flex;align-items:center;gap:6px;margin:0 0 10px;font-size:15px;font-weight:700;color:var(--accent,#35507a);}.ds-day dl{margin:0;}.ds-day dl div{display:flex;justify-content:space-between;padding:4px 0;font-size:14px;}.ds-day dl div+div{border-top:1px dashed var(--border,#dee0d9);}.ds-day dt{color:var(--text-faint,#767a70);}.ds-day dd{margin:0;font-weight:600;color:var(--text,#23241f);}.ds-tag{font-size:11px;font-weight:700;letter-spacing:.04em;background:var(--accent,#35507a);color:var(--accent-contrast,#fff);border-radius:5px;padding:1px 6px;}"
    },
    {
      "name": "Calendar Week Row",
      "kind": "custom",
      "refersTo": "tag-now",
      "description": "行事曆的週次列：左週次、右事項，日期欄等寬對齊；本週以墨藍淡底加標籤。",
      "html": "<div class=\"ds-week\"><div class=\"ds-week-label\"><span class=\"ds-week-num\">第五週 <span class=\"ds-tag\">本週</span></span>09/28(一)~10/04(日)</div><ul><li><span class=\"d\">09/28(一)</span><span class=\"t hol\">教師節放假</span></li><li><span class=\"d\">09/30(三)</span><span class=\"t\">教師研習-班級經營實務經驗分享</span></li></ul></div>",
      "css": ":host{--accent:#35507a;--accent-strong:#25395a;--accent-soft:#e7ecf3;--accent-contrast:#fff;--club:#4f7a5b;--club-soft:#e8f0ea;--warn:#8a5a0c;--warn-soft:#faf0d9;--surface:#fff;--surface-2:#f0f1ee;--border:#dee0d9;--border-strong:#c9ccc2;--text:#23241f;--text-soft:#5f625a;--text-faint:#767a70;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-week{display:grid;grid-template-columns:120px 1fr;gap:16px;background:var(--accent-soft,#e7ecf3);padding:16px 18px;border-radius:12px;font-family:'Noto Sans TC',system-ui,sans-serif;}.ds-week-label{font-size:13px;font-weight:600;color:var(--accent-strong,#25395a);font-variant-numeric:tabular-nums;}.ds-week-num{display:flex;align-items:center;gap:6px;font-size:14px;font-weight:700;}.ds-week ul{display:grid;grid-template-columns:auto 1fr;gap:6px 14px;margin:0;padding:0;list-style:none;font-size:14.5px;color:var(--text,#23241f);}.ds-week li{display:contents;}.ds-week .d{font-size:13px;color:var(--accent,#35507a);font-variant-numeric:tabular-nums;}.ds-week .hol{color:var(--warn,#8a5a0c);font-weight:600;}.ds-tag{font-size:11px;font-weight:700;letter-spacing:.04em;background:var(--accent,#35507a);color:var(--accent-contrast,#fff);border-radius:5px;padding:1px 6px;}"
    },
    {
      "name": "Reminder Note",
      "kind": "custom",
      "refersTo": "reminder-note",
      "description": "便條紙黃的提醒，不用左側色條。",
      "html": "<div class=\"ds-note\"><span class=\"tag\">提醒</span><p><strong>夜光天使</strong>為週一、二、四進行，請以老師近期公告為主。</p></div>",
